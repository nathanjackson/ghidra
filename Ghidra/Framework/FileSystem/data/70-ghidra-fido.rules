# Fallback udev rules for Ghidra FIDO2 (ghidra-fido / libfido2).
#
# Install this file only if FIDO2 security keys have never worked in a browser
# on this machine. Most desktop Linux systems already grant hidraw access to
# the seated user (Chrome/Firefox WebAuthn). Do not install this file in that
# case.
#
#   sudo cp 70-ghidra-fido.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger

# FIDO HID usage page (0xF1D0) is tagged ID_FIDO_APPLICATION by udev 188+.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ENV{ID_FIDO_APPLICATION}=="1", TAG+="uaccess", GROUP="plugdev", MODE="0660"
